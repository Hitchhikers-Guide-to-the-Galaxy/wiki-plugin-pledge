{
  "name": "wiki-plugin-pledge",
  "version": "0.1.0",
  "description": "Federated Wiki - Pledge Plugin: record a 42-second video pledge in the browser, seal it on the farm with ffmpeg (pledge.mp4, pledge.m4a, poster, sha256) and write its page",
  "keywords": ["pledge", "video", "recorder", "wiki", "federated wiki", "plugin", "hitchhiker"],
  "author": { "name": "David Bovill" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-pledge.git" },
  "bugs": { "url": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-pledge/issues" },
  "homepage": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-pledge#readme",
  "files": ["api", "client", "pages", "factory.json", "ReadMe.md"],
  "scripts": {
    "test": "npm run version-file --silent && node --test test/*.test.cjs test/*.test.mjs",
    "version-file": "node -e \"require('fs').writeFileSync('client/version.json', JSON.stringify({version: require('./package.json').version}) + '\\n')\"",
    "prepack": "npm run version-file"
  },
  "dependencies": {},
  "fedwiki": {
    "requires": ["wiki-plugin-farm", "wiki-plugin-video"],
    "api": {
      "version": 1,
      "spec": "api/openapi.json",
      "handlers": "api/handlers.js"
    }
  }
}
